# Какой провайдер WhatsApp использовать сейчас: green или cloud
WHATSAPP_PROVIDER=green

# ==== Green API (сейчас) ====
# Берутся в личном кабинете green-api.com после создания инстанса
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# ==== Meta Cloud API (для будущего перехода, пока можно оставить пустым) ====
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=

# ==== ИИ ====
# Ключ Google Gemini (бесплатный уровень) - aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# ==== CRM (таблица клиентов в Google Sheets) ====
# ID таблицы берётся из её ссылки: docs.google.com/spreadsheets/d/ЭТОТ_ID/edit
GOOGLE_SHEET_ID=
# email сервисного аккаунта Google Cloud (см. README, раздел CRM)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# приватный ключ сервисного аккаунта, вставлять в кавычках, с \n вместо переносов строк
GOOGLE_PRIVATE_KEY=

# ==== Telegram-уведомления и отчёты ====
# токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=
# ваш личный chat_id в Telegram (см. README) - только этому чату бот будет отвечать на /report
TELEGRAM_ADMIN_CHAT_ID=

# ==== Память диалога (необязательно, есть разумные значения по умолчанию) ====
# Сколько последних "сырых" сообщений держать в окне контекста на чат
MAX_HISTORY_MESSAGES=20
# Сколько ждать (мс) перед ответом, чтобы собрать несколько сообщений клиента,
# присланных подряд, в одно
MESSAGE_DEBOUNCE_MS=3500
# Через сколько мс неактивности выгружать чат из ОЗУ (профиль клиента при этом
# не теряется - он уже сохранён в CRM и подтянется заново при новом сообщении)
MEMORY_IDLE_EVICT_MS=21600000
